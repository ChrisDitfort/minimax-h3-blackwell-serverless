# PrivoraVideo MiniMax H3 - model-free RunPod Serverless worker.
#
# GitHub Actions builds this Dockerfile remotely. The inherited Blackwell runtime carries
# CUDA, PyTorch, ComfyUI and the MiniMax H3 nodes, but not the eight approved H3 weights.
# RunPod Cached Models supplies those bytes later at an exact immutable Hub revision.
FROM ghcr.io/nightfall93/runpod-comfyui-minimax-h3:cuda13-blackwell

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV COMFY_DIR=/opt/comfyui-baked \
    COMFY_PORT=8188 \
    COMFY_INPUT_DIR=/workspace/runpod-slim/ComfyUI/input \
    COMFY_OUTPUT_DIR=/workspace/runpod-slim/ComfyUI/output \
    COMFY_TEMP_DIR=/tmp/comfy-temp \
    H3_OUTPUT_MODE=base64 \
    PYTHONUNBUFFERED=1 \
    H3_MODEL_REPO=CDitfort/privora-minimax-h3-models \
    H3_MODEL_REVISION=ecb69a4211d74b5798398021003bccde02d63757 \
    H3_MODEL_MANIFEST_VERSION=multimodal-4-hf-cache-v1 \
    H3_MODEL_CACHE_ROOT=/runpod-volume/huggingface-cache/hub \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1

RUN python3 -m pip install --no-cache-dir --break-system-packages \
        runpod \
        requests \
        websocket-client \
        boto3 \
        cryptography \
 && python3 -c "import runpod, requests, websocket, boto3, cryptography; print('serverless deps OK')"

# Only empty lookup directories are baked. bootstrap.py creates the eight symlinks after
# proving the exact RunPod cache snapshot exists; no compatibility link is created here.
RUN mkdir -p "$COMFY_DIR/models/diffusion_models/h3" \
             "$COMFY_DIR/models/text_encoders" \
             "$COMFY_DIR/models/vae" \
             "$COMFY_DIR/models/loras" \
             /workspace/runpod-slim/ComfyUI/input \
             /workspace/runpod-slim/ComfyUI/output \
             /tmp/comfy-temp

RUN cd "$COMFY_DIR" \
 && mkdir -p user \
 && python3 -c "from alembic import command; from alembic.config import Config; c = Config('alembic.ini'); c.set_main_option('script_location', 'alembic_db'); command.upgrade(c, 'head')" \
 && python3 -c "import sqlite3; r = sqlite3.connect('user/comfyui.db').execute('select version_num from alembic_version').fetchone(); assert r and r[0], 'alembic_version is empty'; print('ComfyUI DB baked at revision', r[0])"

COPY handler.py /opt/serverless/handler.py
COPY artifacts.py /opt/serverless/artifacts.py
COPY bootstrap.py /opt/serverless/bootstrap.py
COPY cached_models.py /opt/serverless/cached_models.py
COPY models/h3-cache-manifest.json /opt/serverless/models/h3-cache-manifest.json
COPY slim-build-identity.json /opt/serverless/slim-build-identity.json
COPY privora /opt/serverless/privora

COPY scripts/verify_ref2va_contract.py /opt/serverless/scripts/verify_ref2va_contract.py
RUN python3 /opt/serverless/scripts/verify_ref2va_contract.py --comfy-root "$COMFY_DIR"

COPY h3_parallel /opt/serverless/h3_parallel
COPY comfy_custom_nodes/h3_parallel_boot.py ${COMFY_DIR}/custom_nodes/h3_parallel_boot.py

# Confirm the inherited runtime and the copied privacy/application surface without a GPU.
WORKDIR /opt/serverless
RUN command -v ffmpeg >/dev/null \
 && test -f "$COMFY_DIR/main.py" \
 && python3 -c "import torch; assert torch.version.cuda, 'CUDA-enabled PyTorch is absent'; print('torch', torch.__version__, 'CUDA', torch.version.cuda)" \
 && python3 -c "import artifacts, cryptography, h3_parallel, privora; print('Privora runtime contract OK')"

# Exact-name rejection comes from the manifest; the size threshold is defense in depth for
# an unexpected alternate checkpoint. This scans the final filesystem after every COPY.
COPY scripts/guard_no_model_weights.py /opt/serverless/scripts/guard_no_model_weights.py
RUN python3 /opt/serverless/scripts/guard_no_model_weights.py \
      --manifest /opt/serverless/models/h3-cache-manifest.json \
      --root /opt --root /workspace --root /root --max-bytes 104857600

ENV H3_GPU_MODE=single \
    H3_SP_MASTER_PORT=29513 \
    H3_SP_VAE=1 \
    H3_SP_SELFTEST=1 \
    H3_IMAGE_DIGEST=unknown \
    COMFYUI_H3_COMMIT=dec5d945 \
    NCCL_DEBUG=WARN

LABEL org.opencontainers.image.source="https://github.com/ChrisDitfort/minimax-h3-blackwell-serverless" \
      ai.privora.model.repository="CDitfort/privora-minimax-h3-models" \
      ai.privora.model.revision="ecb69a4211d74b5798398021003bccde02d63757" \
      ai.privora.model.manifest="multimodal-4-hf-cache-v1"

# bootstrap validates and links the cache before exec'ing the validated handler as PID 1.
ENTRYPOINT ["python3", "/opt/serverless/bootstrap.py"]
CMD []
